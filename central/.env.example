# Copy this file to .env through scripts/install-central.sh.
# Do not commit the resulting .env file.

# Pin a tested OpenObserve OSS release. Do not use `latest` in production.
OPENOBSERVE_IMAGE=public.ecr.aws/zinclabs/openobserve:v0.90.3

# Use 127.0.0.1 when a reverse proxy terminates HTTPS on this server.
# Use a private interface address for a private-network proof of concept only.
OPENOBSERVE_BIND_ADDRESS=127.0.0.1
OPENOBSERVE_HTTP_PORT=5080

ZO_ROOT_USER_EMAIL=root@example.com
ZO_ROOT_USER_PASSWORD=replace-with-a-strong-password
ZO_COMPACT_DATA_RETENTION_DAYS=180
OPENOBSERVE_LOG_LEVEL=info
